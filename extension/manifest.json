{
  "manifest_version": 3,
  "name": "Official Domain Registry 核验器",
  "version": "2.0.0",
  "description": "浏览网页时自动将当前页面域名发送到官方域名注册服务进行核验，并在工具栏图标上显示结果。",
  "permissions": ["tabs", "storage", "webNavigation"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "官方域名核验"
  }
}
